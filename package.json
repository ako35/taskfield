{
    "name": "taskfield",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.15.0",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "dev:api": "pnpm --filter api dev",
        "dev:mobile": "pnpm --filter field-mobile dev",
        "dev:web": "pnpm --filter admin-web dev",
        "infra:down": "docker compose down",
        "infra:up": "docker compose up -d",
        "lint": "turbo lint",
        "test": "turbo test",
        "typecheck": "turbo typecheck"
    },
    "devDependencies": {
        "pnpm": "10.15.0",
        "turbo": "^2.5.6",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=22"
    }
}