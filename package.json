{
    "name": "taskfield",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.15.0",
    "scripts": {
        "build": "turbo build",
        "dev": "node scripts/kill-ports.js && pnpm exec concurrently --kill-others-on-fail --names api,web,mobile --prefix-colors blue,green,magenta \"pnpm --dir apps/api exec nest start --watch\" \"pnpm --dir apps/admin-web exec vite --host 0.0.0.0 --port 5173\" \"pnpm --dir apps/field-mobile exec expo start --web --port 8081 --non-interactive\"",
        "dev:api": "pnpm --dir apps/api exec nest start --watch",
        "dev:all": "pnpm dev",
        "dev:mobile": "pnpm --dir apps/field-mobile exec expo start --web --port 8081 --non-interactive",
        "dev:web": "pnpm --dir apps/admin-web exec vite --host 0.0.0.0 --port 5173",
        "start:dev": "pnpm dev",
        "infra:down": "docker compose down",
        "infra:up": "docker compose up -d",
        "lint": "turbo lint",
        "test": "turbo test",
        "typecheck": "turbo typecheck"
    },
    "devDependencies": {
        "concurrently": "^9.2.0",
        "pnpm": "10.15.0",
        "turbo": "^2.5.6",
        "typescript": "^5.9.2"
    },
    "engines": {
        "node": ">=22"
    }
}