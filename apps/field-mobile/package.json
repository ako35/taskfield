{
  "name": "field-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@taskfield/domain": "workspace:*",
    "expo": "~57.0.12",
    "expo-dev-client": "~57.0.12",
    "expo-location": "^57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-module-scripts": "56.0.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --port 8081",
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "web": "expo start --web --port 8081 --non-interactive",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "update:preview": "eas update --branch preview --auto",
    "update:production": "eas update --branch production --auto"
  },
  "private": true
}